{
  "name": "Firefly III",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "bash .cursor/install.sh",
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "firefly",
      "command": "php artisan serve --host=0.0.0.0 --port=8000",
      "description": "Firefly III Laravel development server on port 8000"
    }
  ]
}
